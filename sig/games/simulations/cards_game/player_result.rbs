module Games
  module Simulations
    module CardsGame
      class PlayerResult
        @id: String

        @name: String

        @cards_remaining: Integer
        @open_cards: Array[Card]

        attr_reader id: String
        attr_reader name: String
        attr_reader cards_remaining: Integer
        attr_reader open_cards: Array[Card]

        def initialize: (Player player) -> void
      end
    end
  end
end
