<p style="color: green"><%= notice %></p>

<% content_for :title, "Card games" %>

<h1>Card games</h1>

<div id="games_card_games">
  <% @games_card_games.each do |games_card_game| %>
    <%= render games_card_game %>
    <p>
      <%= link_to "Show this card game", games_card_game %>
    </p>
  <% end %>
</div>

<%= link_to "New card game", new_games_card_game_path %>
